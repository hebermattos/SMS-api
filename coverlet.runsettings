<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- SQL adapters and the Compose-validated seed executable are integration concerns, not unit-test coverage targets. -->
          <Exclude>[TextRelay.Seed]*,[TextRelay.Infrastructure]Sms.Infrastructure.Persistence.*,[TextRelay.Infrastructure]Sms.Infrastructure.Observability.Postgres*Exporter,[TextRelay.Infrastructure]Sms.Infrastructure.Messaging.AlertEvaluationOutboxPublisher*,[TextRelay.Infrastructure]Sms.Infrastructure.Messaging.AlertEvaluationConsumer*,[TextRelay.Infrastructure]Sms.Infrastructure.Messaging.SmsSendOutboxPublisher*,[TextRelay.Infrastructure]Sms.Infrastructure.Messaging.SmsSendConsumer*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
