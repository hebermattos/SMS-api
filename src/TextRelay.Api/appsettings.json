{
  "ConnectionStrings": {
    "Postgres": "",
    "LogsPostgres": "",
    "ReportingPostgres": "",
    "Redis": ""
  },
  "Cache": {
    "Enabled": true
  },
  "Jwt": {
    "Issuer": "TextRelay.Api",
    "Audience": "TextRelay.Api.Clients",
    "Key": "",
    "ExpirationMinutes": 60
  },
  "Encryption": {
    "MasterKey": ""
  },
  "Sms": {
    "DefaultProvider": "Twilio",
    "PublicBaseUrl": ""
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "LogLevel": {
        "Sms": "Information"
      }
    }
  },
  "SmsRetry": {
    "MaxAttempts": 3,
    "InitialIntervalSeconds": 60
  }
}
